# PostgreSQL connection (used by the db service in docker-compose)
POSTGRES_USER=nepse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nepse_db

# DATABASE_URL is set automatically by docker-compose from the above vars.
# Override here only if connecting to an external database.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nepse_db

# Secret key for the X-API-Key header
API_KEY=change-me

# Local directory for WASM and SSL certificate cache
CACHE_DIR=.cache

# Set to true to enable /debug/* endpoints
DEBUG_MODE=false
